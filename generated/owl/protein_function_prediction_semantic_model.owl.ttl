<https://w3id.org/protein-function-prediction-semantic-model.owl.ttl> dcterms:title "Semantic model of protein function prediction" ;
	pav:version "0.0.0" ;
	a owl:Ontology ;
	rdfs:label "protein_function_prediction_semantic_model" ;
	skos:definition "The single versioned description of the concepts of protein function prediction, of the components that implement or document them, and of the relations between them. It is named after the problem, not after any tool: PROTEA, the open science platform, is one of its components. Its first ring is concept, component and relation; the model itself is a SKOS concept scheme. Two words are reserved: ontology names only the Gene Ontology, and term names only a GO term." .
protein_function_prediction:Component a owl:Class ;
	rdfs:label "Component" ;
	rdfs:subClassOf _:c14n102 , _:c14n111 , _:c14n13 , _:c14n19 , _:c14n20 , _:c14n24 , _:c14n25 , _:c14n27 , _:c14n39 , _:c14n46 , _:c14n48 , _:c14n62 , _:c14n70 , _:c14n76 , _:c14n80 , _:c14n84 , _:c14n88 , _:c14n93 ;
	skos:definition "A piece of the project (code, data store, document, panel) that implements or documents concepts. Not filled in version 0." ;
	skos:exactMatch prov:Entity ;
	skos:inScheme <https://w3id.org/protein-function-prediction-semantic-model> .
protein_function_prediction:Concept a owl:Class ;
	rdfs:label "Concept" ;
	rdfs:subClassOf _:c14n10 , _:c14n101 , _:c14n103 , _:c14n105 , _:c14n108 , _:c14n109 , _:c14n113 , _:c14n115 , _:c14n117 , _:c14n12 , _:c14n14 , _:c14n15 , _:c14n17 , _:c14n22 , _:c14n29 , _:c14n3 , _:c14n31 , _:c14n32 , _:c14n34 , _:c14n35 , _:c14n37 , _:c14n41 , _:c14n50 , _:c14n54 , _:c14n57 , _:c14n59 , _:c14n6 , _:c14n61 , _:c14n64 , _:c14n69 , _:c14n7 , _:c14n81 , _:c14n83 , _:c14n87 , _:c14n90 , _:c14n92 , _:c14n94 , _:c14n96 , _:c14n97 , _:c14n99 ;
	skos:definition "A unit of meaning of protein function prediction. Every concept carries the same card: canonical name, English label and definition, a Spanish label for the Spanish user interface, its top category, the names it has today and where, and its external equivalent." ;
	skos:exactMatch skos:Concept ;
	skos:inScheme <https://w3id.org/protein-function-prediction-semantic-model> .
