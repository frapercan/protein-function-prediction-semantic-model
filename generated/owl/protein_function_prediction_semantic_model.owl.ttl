protein_function_prediction_slot:ladder_order a owl:DatatypeProperty ;
	rdfs:label "ladder_order" ;
	rdfs:range _:c14n60 ;
	skos:definition "Where a rung of the literature ladder sits in it: an integer, spaced by ten so that a later rung is inserted without renumbering the others. Only a rung card carries it, and the ladder is the cards that do, sorted by it." ;
	skos:inScheme <https://w3id.org/protein-function-prediction-semantic-model> .
protein_function_prediction_slot:ladder_position a owl:DatatypeProperty ;
	rdfs:label "ladder_position" ;
	rdfs:range _:c14n115 ;
	skos:definition "The label a rung is shown with in the ladder, such as 2b; carried only with a ladder order." ;
	skos:inScheme <https://w3id.org/protein-function-prediction-semantic-model> .
protein_function_prediction_slot:method_family a owl:DatatypeProperty ;
	rdfs:label "method_family" ;
	skos:definition "The family of a rung's method, one of the values of the method family concept. The family is part of a method's identity, so a rung whose writers register no method of their own (the reading of an arm) carries none." ;
	skos:inScheme <https://w3id.org/protein-function-prediction-semantic-model> .
protein_function_prediction:status a owl:ObjectProperty ;
	rdfs:label "status" ;
