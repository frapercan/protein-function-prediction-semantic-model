protein_function_prediction:candidate_names a owl:DatatypeProperty ;
	rdfs:label "candidate_names" ;
	skos:definition "The English names proposed for the concept. More than one means the row of the closure map groups several concepts that still have to be split." ;
	skos:inScheme <https://w3id.org/protein-function-prediction-semantic-model> .
protein_function_prediction:canonical_name a owl:DatatypeProperty ;
	rdfs:label "canonical_name" ;
