{
    "$defs": {
        "Component": {
            "additionalProperties": false,
            "description": "A piece of the project (code, data store, document, panel) that implements or documents concepts. Not filled in version 0.",
            "properties": {
                "description": {
                    "description": "What the element is, in English prose.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "documents_concepts": {
                    "description": "The concepts the component documents.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "id": {
                    "description": "Stable identifier in snake_case English. In version 0 it is provisional and follows the first candidate name.",
                    "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
                    "type": "string"
                },
                "implements": {
                    "description": "The concepts the component implements.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "label_en": {
                    "description": "Label in English.",
                    "type": "string"
                },
                "label_es": {
                    "description": "Label in Spanish, for the Spanish user interface; the only field of a concept that is not in English.",
                    "type": "string"
                },
                "paths": {
                    "description": "Where the component lives, as repository paths.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "required": [
                "id",
                "label_en",
                "label_es"
            ],
            "title": "Component",
            "type": "object"
        },
        "Concept": {
            "additionalProperties": false,
            "description": "A unit of meaning of protein function prediction. Every concept carries the same card: canonical name, English label and definition, a Spanish label for the Spanish user interface, its top category, the names it has today and where, and its external equivalent.",
            "if": {
                "properties": {
                    "status": {
                        "const": "accepted"
                    }
                },
                "required": [
                    "status"
                ]
            },
            "properties": {
                "candidate_names": {
                    "description": "The English names proposed for the concept. More than one means the row of the closure map groups several concepts that still have to be split.",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "canonical_name": {
                    "description": "The one name chosen by the author. Required once the concept is accepted.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "current_names": {
                    "description": "The names the concept has today, place by place.",
                    "items": {
                        "$ref": "#/$defs/NameUse"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "definition_en": {
                    "description": "Definition in English.",
                    "type": "string"
                },
                "deprecated_names": {
                    "description": "Names retired once the canonical name is accepted; a check refuses them.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "examples": {
                    "description": "Instances that show the concept, verbatim.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "external_match": {
                    "description": "The equivalent outside the project (a standard, a vocabulary or a paper), as text.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "id": {
                    "description": "Stable identifier in snake_case English. In version 0 it is provisional and follows the first candidate name.",
                    "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
                    "type": "string"
                },
                "label_en": {
                    "description": "Label in English.",
                    "type": "string"
                },
                "label_es": {
                    "description": "Label in Spanish, for the Spanish user interface; the only field of a concept that is not in English.",
                    "type": "string"
                },
                "naming_conflict": {
                    "description": "Why the current names conflict, as the closure map found it.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "review_note": {
                    "description": "A fact found after the import that the review has to settle.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "status": {
                    "$ref": "#/$defs/NameStatus",
                    "description": "Whether the canonical name of the concept is chosen."
                },
                "top_category": {
                    "$ref": "#/$defs/TopCategory",
                    "description": "The broadest kind the concept belongs to."
                },
                "values": {
                    "description": "The closed set of values the concept takes, when it has one.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "required": [
                "id",
                "status",
                "label_en",
                "label_es",
                "candidate_names",
                "top_category",
                "definition_en"
            ],
            "then": {
                "properties": {
                    "canonical_name": {}
                },
                "required": [
                    "canonical_name"
                ]
            },
            "title": "Concept",
            "type": "object"
        },
        "NameStatus": {
            "description": "Where a concept stands in the choice of its canonical name.",
            "enum": [
                "candidate",
                "accepted"
            ],
            "title": "NameStatus",
            "type": "string"
        },
        "NameUse": {
            "additionalProperties": false,
            "description": "The names one place of the project gives to a concept today.",
            "properties": {
                "names": {
                    "description": "The names used there, verbatim.",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "where": {
                    "description": "The place, such as the ORM, the user interface, the panel or the laboratory code.",
                    "type": "string"
                }
            },
            "required": [
                "where",
                "names"
            ],
            "title": "NameUse",
            "type": "object"
        },
        "Relation": {
            "additionalProperties": false,
            "description": "A named, directed link from one component to another. Not filled in version 0.",
            "properties": {
                "object": {
                    "description": "The component the relation points to.",
                    "type": "string"
                },
                "predicate": {
                    "$ref": "#/$defs/RelationKind",
                    "description": "The kind of the relation."
                },
                "subject": {
                    "description": "The component the relation starts from.",
                    "type": "string"
                }
            },
            "required": [
                "subject",
                "predicate",
                "object"
            ],
            "title": "Relation",
            "type": "object"
        },
        "RelationKind": {
            "description": "The relation kinds of the closure map.",
            "enum": [
                "produces_data_for",
                "evaluates",
                "explains",
                "imports",
                "calls",
                "launches",
                "configures",
                "deploys",
                "documents",
                "duplicates",
                "replaces"
            ],
            "title": "RelationKind",
            "type": "string"
        },
        "SemanticModel": {
            "additionalProperties": false,
            "description": "The model itself: one versioned description from which the glossary, the component map, interface texts and contract schemas are generated.",
            "properties": {
                "components": {
                    "description": "The components of the project that implement or document concepts.",
                    "items": {
                        "$ref": "#/$defs/Component"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "concepts": {
                    "description": "The concepts of the model.",
                    "items": {
                        "$ref": "#/$defs/Concept"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "description": {
                    "description": "What the element is, in English prose.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "id": {
                    "description": "Stable identifier in snake_case English. In version 0 it is provisional and follows the first candidate name.",
                    "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
                    "type": "string"
                },
                "relations": {
                    "description": "The named, directed links between components.",
                    "items": {
                        "$ref": "#/$defs/Relation"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "title": {
                    "description": "The title of the model.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "version": {
                    "description": "The semantic version of the model; 0.x while names are candidates.",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "id"
            ],
            "title": "SemanticModel",
            "type": "object"
        },
        "TopCategory": {
            "description": "The top categories of version 0, as the closure map gave them.",
            "enum": [
                "data",
                "component",
                "method",
                "method_family",
                "activity",
                "document"
            ],
            "title": "TopCategory",
            "type": "string"
        }
    },
    "$id": "https://w3id.org/protein-function-prediction-semantic-model",
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "additionalProperties": false,
    "description": "The model itself: one versioned description from which the glossary, the component map, interface texts and contract schemas are generated.",
    "metamodel_version": "1.12.0",
    "properties": {
        "components": {
            "description": "The components of the project that implement or document concepts.",
            "items": {
                "$ref": "#/$defs/Component"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "concepts": {
            "description": "The concepts of the model.",
            "items": {
                "$ref": "#/$defs/Concept"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "description": {
            "description": "What the element is, in English prose.",
            "type": [
                "string",
                "null"
            ]
        },
        "id": {
            "description": "Stable identifier in snake_case English. In version 0 it is provisional and follows the first candidate name.",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
            "type": "string"
        },
        "relations": {
            "description": "The named, directed links between components.",
            "items": {
                "$ref": "#/$defs/Relation"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "title": {
            "description": "The title of the model.",
            "type": [
                "string",
                "null"
            ]
        },
        "version": {
            "description": "The semantic version of the model; 0.x while names are candidates.",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "type": [
                "string",
                "null"
            ]
        }
    },
    "required": [
        "id"
    ],
    "title": "protein_function_prediction_semantic_model",
    "type": "object",
    "version": "0.0.0"
}

